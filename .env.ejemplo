# Base compartida de GxPruebas: copia este archivo como .env y completa tus datos.
# .env no va al repositorio. Las variables de entorno de Windows con el mismo nombre tienen prioridad.
# Sin GXP_DB_HOST, GxPruebas usa los archivos locales (suites\, config.json, revisor.json).
GXP_DB_HOST=gascode.com.ar
GXP_DB_PORT=3306
GXP_DB_USER=
GXP_DB_PASSWORD=
GXP_DB_NAME=gxpruebas

# Opcionales
# GXP_USUARIO=tu-nombre          nombre que queda en cada cambio (por defecto, tu usuario de Windows)
# GXP_DB_SSL=no                  no cifra la conexion (por defecto cifra si el servidor lo permite)
# GXP_DB_SSL_CA=C:\ruta\ca.pem   ademas verifica el certificado del servidor
# GXP_EDITOR=code --wait         editor de 'compartido editar' (por defecto, notepad)

# GeneXus: Update y Build de las KBs (pestaña GeneXus). Usuario y clave del servidor de las KBs (GXserver):
GXP_GX_USUARIO=
GXP_GX_CLAVE=
# Opcionales (mandan sobre config.json, clave "genexus"):
# GXP_GX_INSTALACION=C:\GeneXus\GeneXus18u15b188745   carpeta con TeamDev.msbuild (por defecto, la mas nueva de C:\GeneXus)
# GXP_GX_MSBUILD=C:\Windows\Microsoft.NET\Framework4.0.30319\MSBuild.exe   debe ser de 32 bits
# GXP_GX_PARALELO=3              KBs que se procesan a la vez
