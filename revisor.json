{
  "ignorar": [
    "WWPBaseObjects.*",
    "WorkWithPlus*",
    "GAM*",
    "GeneXus.*",
    "*LoadDVCombo",
    "Cobranzas.Global.sdtErroresToSdtOutput"
  ],
  "ignorarGeneradosPorPattern": true,
  "reglas": {
    "sin-commit-rollback": {
      "activa": true,
      "severidad": "error",
      "tiposPermitidos": ["web"],
      "objetosCommit": ["prcCommit", "prcRollback"],
      "commitOnExit": ["proc", "mnproc"]
    },
    "salida-ok-mensajes": {
      "activa": true,
      "severidad": "error",
      "sdt": "sdtOutput",
      "tipos": ["proc", "mnproc"],
      "ayudantes": {
        "Sistema.Output.AddMessage": {"tipo": 2, "salida": 3},
        "Sistema.Output.AddMessages": {"tipo": null, "salida": 2}
      }
    },
    "alta-devuelve-id": {
      "activa": true,
      "severidad": "advertencia",
      "tipos": ["proc", "mnproc"],
      "nombresAlta": "^(set|put|crear|alta|agregar|insert|nuev[oa]|registrar|guardar|grabar|new|add)|(set|put|crear|alta|agregar|insert|nuev[oa]|registrar|guardar|grabar|new|add)\\d*$",
      "nombresOtraOperacion": "(get|lista|obtener|buscar|consulta|actualizar|modificar|update|delete|eliminar|borrar|baja|cambiar|cambio|mover|marcar|leido|procesar|check|enviar|validar|calcular|importar|carga|migra|confirmar)",
      "entidadesExcluidas": "(hist|historial|history|log|bitacora|auditoria)(_bc)?$"
    }
  },
  "excepciones": [
    {
      "regla": "sin-commit-rollback",
      "objeto": "*.prcCommit",
      "motivo": "Es el procedimiento que centraliza el commit: lo llaman los Web Panels."
    },
    {
      "regla": "sin-commit-rollback",
      "objeto": "*.prcRollback",
      "motivo": "Es el procedimiento que centraliza el rollback: lo llaman los Web Panels."
    }
  ]
}
